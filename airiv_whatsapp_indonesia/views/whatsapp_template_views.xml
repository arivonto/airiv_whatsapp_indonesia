<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_airiv_whatsapp_template_tree" model="ir.ui.view">
            <field name="name">airiv.whatsapp.template.list</field>
            <field name="model">airiv.whatsapp.template</field>
            <field name="arch" type="xml">
                <list string="WhatsApp Templates">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_airiv_whatsapp_template_form" model="ir.ui.view">
            <field name="name">airiv.whatsapp.template.form</field>
            <field name="model">airiv.whatsapp.template</field>
            <field name="arch" type="xml">
                <form string="WhatsApp Template">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group string="Indonesian Message Template Text">
                            <field name="body" nolabel="1" placeholder="Write localized template in Bahasa Indonesia..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_airiv_whatsapp_template" model="ir.actions.act_window">
            <field name="name">WhatsApp Templates</field>
            <field name="res_model">airiv.whatsapp.template</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
