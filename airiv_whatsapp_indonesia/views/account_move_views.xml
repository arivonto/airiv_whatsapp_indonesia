<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_whatsapp_inherit" model="ir.ui.view">
            <field name="name">account.move.form.whatsapp.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_send_whatsapp_invoice_billing" string="Send WhatsApp Invoice" type="object" class="btn-secondary" invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund')"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
