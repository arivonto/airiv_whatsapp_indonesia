<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_picking_form_whatsapp_inherit" model="ir.ui.view">
            <field name="name">stock.picking.form.whatsapp.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_send_whatsapp_dispatch_alert" string="Send WhatsApp Resi" type="object" class="btn-secondary" invisible="state != 'done'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
