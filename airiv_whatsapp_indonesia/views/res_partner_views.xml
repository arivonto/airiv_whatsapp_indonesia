<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_form_whatsapp_inherit" model="ir.ui.view">
            <field name="name">res.partner.form.whatsapp.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='mobile']" position="after">
                    <field name="l10n_id_whatsapp" placeholder="e.g. 081234567890"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
