<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_form_whatsapp_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.whatsapp.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_send_whatsapp_order_confirmation" string="Send WhatsApp SO" type="object" class="btn-secondary" invisible="state not in ('sale')"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
